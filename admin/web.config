<?xml version="1.0" encoding="UTF-8"?>
<!-- MedicGLOBAL — painel /admin (PHP) em IIS. Não precisa de URL Rewrite: a API fica em /admin/api.php/<rota>.
     index.php é o documento padrão; config.php, lib/, data/ e tools/ ficam inacessíveis pela URL. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="lib" />
          <add segment="data" />
          <add segment="tools" />
          <add segment="config.php" />
          <add segment="config.sample.php" />
        </hiddenSegments>
        <!-- envio de imagens e PDFs pelo painel (até 16 MB) e anexos do Trabalhe conosco -->
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
    <!-- o painel gera suas próprias respostas; não herda a regra de 404 do site -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
