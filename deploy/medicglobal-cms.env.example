# Copiar para /etc/medicglobal-cms.env (dono root, permissão 600). NÃO versionar o arquivo preenchido.
# Pasta de dados do painel: usuários (hash), conteúdo, uploads, mensagens. Fora do repositório e fora da pasta do nginx.
CMS_DATA_DIR=/var/lib/medicglobal-cms
# Pasta servida pelo nginx (a mesma de hoje, VPS_PATH do deploy)
CMS_PUBLIC_DIR=/var/www/medicglobal
# Chave que cifra tokens e senhas de integrações (GA, SMTP, webhooks). Gerar com: openssl rand -hex 32
CMS_SECRET_KEY=
CMS_PORT=8788
CMS_HOST=127.0.0.1
# atrás do nginx: usa X-Forwarded-For/Proto (IP real nos bloqueios e cookie "Secure" em HTTPS)
CMS_TRUST_PROXY=1
