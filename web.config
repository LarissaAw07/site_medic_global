<?xml version="1.0" encoding="UTF-8"?>
<!--
  MedicGLOBAL 2.0 - hospedagem HTML+PHP em IIS (Windows).
  OBS: NAO usa mais URL Rewrite. Os proxies sao PASTAS REAIS (rede-api/ e guia-api/),
  entao este web.config e OPCIONAL - serve so para a pagina 404 e os MIME de fontes.
  Se a hospedagem reclamar de qualquer coisa aqui, pode ate remover o arquivo que o site funciona.
-->
<configuration>
  <system.webServer>

    <!-- Pagina 404 personalizada -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Documento padrao -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- MIME de fontes/assets (IIS nao serve tipos desconhecidos; remove+add evita duplicata) -->
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

  </system.webServer>
</configuration>
