<?xml version="1.0" encoding="UTF-8"?>
<!-- MedicGLOBAL — painel /admin (PHP) em IIS. Define index.php como documento padrão e
     bloqueia o acesso direto à configuração (com as credenciais do MySQL) e à pasta lib/. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <!-- impede baixar config.php / config.sample.php e entrar em lib/ pela URL -->
        <hiddenSegments>
          <add segment="lib" />
          <add segment="config.php" />
          <add segment="config.sample.php" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- o painel gera suas próprias páginas; não herda a regra de 404 do site -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
